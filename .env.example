# ==================================================
# GATHBANDHAN ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================
# NOTE: This file contains template placeholders only.
# All 'localhost' / '127.0.0.1' values below are LOCAL-DEVELOPMENT examples only.
# Replace all placeholders and local hostnames with your actual production infrastructure values upon deployment.

# ==================================================
# 1. BACKEND (Spring Boot - Secrets & Infrastructure)
# ==================================================
# Server & Port
SERVER_PORT=9090

# Security & JWT (Must be a strong 256-bit+ secret in production)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_for_production_hs512

# PostgreSQL Database (Example: jdbc:postgresql://db.example.com:5432/gathbandhan_prod)
DATABASE_URL=jdbc:postgresql://localhost:5432/gathbandhan_db
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password

# HikariCP Connection Pool
HIKARI_MAX_POOL_SIZE=50

# Redis Cache & Sessions (Example host: redis.example.com)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# File Upload Configuration
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
FILE_UPLOAD_DIR=/opt/gathbandhan/uploads

# SMTP Email Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=notifications@example.com

# Domain URLs (Production examples: https://api.gathbandhan.com, https://gathbandhan.com)
BACKEND_URL=http://localhost:9090
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:9090

# SMS Integration (MSG91)
SMS_ENABLED=false
MSG91_AUTH_KEY=your_msg91_auth_key

# Payment Gateway (Razorpay Backend Secrets)
RAZORPAY_API_KEY=your_razorpay_api_key
RAZORPAY_API_SECRET=your_razorpay_api_secret

# Astrology API (Prokerala)
PROKERALA_CLIENT_ID=your_prokerala_client_id
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret
PROKERALA_BASE_URL=https://api.prokerala.com

# Bot Protection (reCAPTCHA v3 Backend Verification)
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your_recaptcha_public_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Transactional Bulk Email Provider API
BULK_EMAIL_API_KEY=your_bulk_email_api_key
BULK_EMAIL_PROVIDER_NAME=Gathbandhan-Bulk-API-Provider

# RabbitMQ Message Broker (Example host: rabbitmq.example.com)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/

# ==================================================
# 2. USER FRONTEND (React / Vite - Public Variables Only)
# ==================================================
# Public API & WebSocket Base Endpoints (Vite build-time injection)
# Production examples: https://api.gathbandhan.com/api, https://api.gathbandhan.com/ws
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
VITE_BACKEND_URL=http://localhost:9090

# Public Service & Analytics Keys (PUBLIC ONLY - NEVER SECRET)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_public_site_key
VITE_RAZORPAY_KEY=your_razorpay_public_api_key
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==================================================
# 3. ADMIN FRONTEND (React / Vite - Public Variables Only)
# ==================================================
# Public Admin API & WebSocket Endpoints
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
VITE_BACKEND_URL=http://localhost:9090
